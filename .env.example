# Copy to .env. Values below match docker-compose.yml.

# Runtime connection: non-owner role, subject to row-level security
DATABASE_URL=postgres://dental_app:dental_app@localhost:5433/dental?sslmode=disable
# Migration connection: schema owner
MIGRATE_DATABASE_URL=postgres://dental_owner:dental_owner@localhost:5433/dental?sslmode=disable

# Tests: superuser on the postgres-test service. Each test package creates and drops its
# own database there. Remove this line to have tests start Postgres with testcontainers.
TESTDB_ADMIN_URL=postgres://postgres:postgres@localhost:5434/postgres?sslmode=disable

HTTP_ADDR=:8080
# Origin the browser uses; unsafe requests from other origins are rejected
APP_ORIGIN=http://localhost:5173

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Dental SaaS <no-reply@dental.local>

LOG_LEVEL=info
